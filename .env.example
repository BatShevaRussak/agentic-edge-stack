# Copy to `.env` and adjust locally if needed.

# --- Ollama ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
REQUEST_TIMEOUT=120

# --- RAG (Part 2) ---
# EMBED_MODEL_NAME accepts either a HuggingFace repo id
# (e.g. BAAI/bge-small-en-v1.5) or a local directory path. A local path
# is used by default for fully offline deployments.
EMBED_MODEL_NAME=./models/bge-small-en-v1.5
EMBED_DIM=384
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.5
DATA_DIR=data
CACHE_DIR=data/cache

# --- API (Part 4) ---
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins. Use ["*"] for development; restrict in production.
API_CORS_ORIGINS=["*"]
# Seconds between SSE keepalive comments (prevents idle proxies cutting the stream).
SSE_KEEPALIVE_SECONDS=15
